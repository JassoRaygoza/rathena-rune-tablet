diff --git a/conf/atcommands.yml b/conf/atcommands.yml
index 9ff52bbf2..15142c2a0 100644
--- a/conf/atcommands.yml
+++ b/conf/atcommands.yml
@@ -1120,6 +1120,12 @@ Body:
   - Command: refineui
     Help: |
       Opens the refine UI.
+  - Command: runetablet
+    Help: |
+      Params: [close]
+      Opens or closes the native Rune Tablet interface (GM level 99 only).
+      Players use the Rune Stone NPC, gated by rune_tablet_min_group_level in conf/battle/feature.conf.
+      Supports activate, equip/unequip, upgrade, collection rewards and card decomposition.
   - Command: refresh
     Help: |
       Synchronizes the position and state between client and server.
diff --git a/conf/battle/feature.conf b/conf/battle/feature.conf
index 9fd088e13..129ea087d 100644
--- a/conf/battle/feature.conf
+++ b/conf/battle/feature.conf
@@ -184,3 +184,15 @@ feature.stylist: on
 // If this is allowed the "nosave" mapflag is still being respected
 // and may prevent players from warping back into the instance.
 //feature.instance_allow_reconnect: yes
+
+// Minimum group level that can open and use Rune Tablet (0-99).
+// 99 keeps it GM-only for testing; 0 opens it to every player through the
+// Rune Stone NPCs (npc/custom/rune_tablet/rune_stone.txt).
+rune_tablet_min_group_level: 99
+
+// Local policy, NOT a verified official quantity algorithm.
+// yes: independent output chance rolls, then uniform inclusive quantities.
+// Uses the existing DB rates/ranges; does not change batch sizes or access.
+// no: only the reviewed fixed sealed-stone conversion is enabled.
+// Enabled 2026-09-23 by server owner decision; no official algorithm found.
+rune_tablet_decomposition_uniform: yes
