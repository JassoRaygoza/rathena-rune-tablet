+
+/**
+ * Opens the native Rune Tablet window (GM level 99).
+ * Usage: @runetablet [close]. activate remains a compatibility alias.
+ */
+ACMD_FUNC(runetablet)
+{
+	nullpo_retr(-1, sd);
+	if (pc_get_group_level(sd) < 99)
+		return -1;
+	if (message && strcmp(message, "close") == 0) {
+		rune_tablet_close(*sd);
+		return 0;
+	}
+	if (message && *message && strcmp(message, "activate") != 0) {
+		clif_displaymessage(fd, "Usage: @runetablet [close]");
+		return -1;
+	}
+	return rune_tablet_open(*sd) ? 0 : -1;
+}
